# ── App ──────────────────────────────────────────────
ENVIRONMENT=development
PROCESSOR_VERSION=v1        # v1 pass-through | v2 FinBERT sentiment | v3 (later)

# ── API cache TTLs (seconds) ─────────────────────────
# FEED_CACHE_TTL=60
# SENTIMENT_STATS_TTL=300

# ── Kafka ────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_CONSUMER_GROUP=finpulse-ai-consumer

# ── Redis ────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── PostgreSQL / Supabase (needed from Phase 3 onward) ─
DATABASE_URL=postgresql://user:password@localhost:5432/finpulse
SUPABASE_URL=
SUPABASE_KEY=

# ── News sources (needed from Phase 2 onward) ─────────
NEWSAPI_KEY=

# ── AI (needed from Phase 5/6 onward) ─────────────────
GROQ_API_KEY=                        # V3 summaries; blank => articles stored without a summary
# FINBERT_MODEL=ProsusAI/finbert                          # V2 sentiment model (HF id)
# GROQ_MODEL=openai/gpt-oss-20b                           # V3 summary model
# GROQ_MIN_INTERVAL_MS=2100                               # client-side Groq throttle
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2  # V3 embeddings (384-dim)
# CHROMA_COLLECTION=articles
# ALERT_IMPACT_THRESHOLD=8                                # impact_score >= this -> 'alerts' topic

# ── Vector DB (needed from Phase 6 onward) ────────────
CHROMA_HOST=localhost
CHROMA_PORT=8002
